{
  "name": "@nighty90/pi-timestamps",
  "version": "1.0.0",
  "description": "Append timestamps to user messages in the pi coding agent so the model can perceive elapsed time between turns.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "timestamps",
    "time-awareness"
  ],
  "author": "nighty90",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nighty90/pi-timestamps.git"
  },
  "homepage": "https://github.com/nighty90/pi-timestamps#readme",
  "bugs": {
    "url": "https://github.com/nighty90/pi-timestamps/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.78.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
